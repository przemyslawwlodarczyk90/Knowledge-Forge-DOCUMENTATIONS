# =====================================================================
# Knowledge-Forge-DOCUMENTATIONS — zmienne środowiskowe
# =====================================================================
# Skopiuj ten plik jako ".env" (jest w .gitignore — NIGDY go nie commituj)
# i uzupełnij prawdziwymi wartościami. Plik .env czytają:
#   - aplikacja (AppConfig, katalog uruchomienia "java -jar"),
#   - docker compose (automatycznie),
#   - testy integracyjne (TestDatabase).
# Prawdziwe zmienne środowiskowe procesu mają pierwszeństwo przed .env.

# --- Baza danych (WYMAGANE — bez nich aplikacja nie wystartuje) -------
DB_NAME=knowledge_forge
DB_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/knowledge_forge
DB_USERNAME=<uzytkownik_bazy>
DB_PASSWORD=<haslo_bazy>

# --- Administracyjny restore bazy (domyślnie wyłączony) ---------------
# Włączaj tylko świadomie, lokalnie. Sekret wygeneruj np.: openssl rand -hex 32
BACKUP_RESTORE_ENABLED=false
BACKUP_RESTORE_SECRET=

# --- Opcjonalne nadpisania (każdy klucz z config.properties) ----------
# Konwencja: "server.port" -> SERVER_PORT, "backup.retention-days" -> BACKUP_RETENTION_DAYS
# SERVER_PORT=8081
# CORS_ALLOWED_ORIGIN=http://localhost:3000
# NOTES_STORAGE_PATH=./data/notes
# ATTACHMENTS_STORAGE_PATH=./data/attachments
# DEBUG_LOGGING=false
